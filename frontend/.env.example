# Existing scanner backend (server-side only). Never use NEXT_PUBLIC for secrets.
BACKEND_URL=http://127.0.0.1:8000
# Optional alternative authorized Solana Mainnet RPC; public default is keyless.
WALLET_INTEL_RPC_URL=https://api.mainnet-beta.solana.com
# Enable background intelligence at server start. Docker runtime enables this.
WALLET_INTEL_AUTOSTART=1
# Only when the existing backend requires bearer authentication:
WALLET_INTEL_BACKEND_TOKEN=

# Optional full top-20 holder inspection: requires an RPC that serves getTokenLargestAccounts.
# Public Solana endpoints disable that method; launch-wallet checks work without it.
WALLET_INTEL_FULL_HOLDERS=0
